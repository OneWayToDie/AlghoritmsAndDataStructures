<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Основные цвета: чёрный фон, жёлтые акценты -->
    <SolidColorBrush x:Key="MainBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="CaptionBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="FooterBackground" Color="#222222"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="MainTextForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CaptionForeground" Color="#F5C518"/>
    <SolidColorBrush x:Key="ResultForeground" Color="#FFD700"/>

    <!-- Элементы -->
    <SolidColorBrush x:Key="TileBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="TileForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TileBorderBrush" Color="#555555"/>
    <SolidColorBrush x:Key="TileHoverBackground" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="TilePressedBackground" Color="#2A2A2A"/>

    <!-- Кнопка "Вычислить" и активная вкладка -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#F5C518"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#FFD700"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#D4A800"/>

    <!-- Рамка окна -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#F5C518"/>
    <Thickness x:Key="WindowBorderThickness">2</Thickness>

    <SolidColorBrush x:Key="FooterForeground" Color="#888888"/>
</ResourceDictionary>