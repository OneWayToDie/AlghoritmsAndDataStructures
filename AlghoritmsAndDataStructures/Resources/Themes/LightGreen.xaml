<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Основные фоны -->
    <SolidColorBrush x:Key="MainBackground" Color="#F5F9F0"/>
    <SolidColorBrush x:Key="CaptionBackground" Color="#2E7D32"/>
    <SolidColorBrush x:Key="FooterBackground" Color="#E8EDE0"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="MainTextForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="CaptionForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ResultForeground" Color="#1B5E20"/>

    <!-- Элементы (вкладки, поля) -->
    <SolidColorBrush x:Key="TileBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TileForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TileBorderBrush" Color="#A5D6A7"/>
    <SolidColorBrush x:Key="TileHoverBackground" Color="#E8F5E9"/>
    <SolidColorBrush x:Key="TilePressedBackground" Color="#C8E6C9"/>

    <!-- Кнопка "Вычислить" и активная вкладка -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#2E7D32"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#388E3C"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#1B5E20"/>

    <!-- Рамка окна -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#2E7D32"/>
    <Thickness x:Key="WindowBorderThickness">2</Thickness>

    <SolidColorBrush x:Key="FooterForeground" Color="#666666"/>
</ResourceDictionary>