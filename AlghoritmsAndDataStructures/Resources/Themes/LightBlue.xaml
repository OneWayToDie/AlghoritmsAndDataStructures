<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Основные фоны -->
    <SolidColorBrush x:Key="MainBackground" Color="#F2F6FC"/>
    <SolidColorBrush x:Key="CaptionBackground" Color="#1E63A8"/>
    <SolidColorBrush x:Key="FooterBackground" Color="#E4ECF6"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="MainTextForeground" Color="#1A1F2E"/>
    <SolidColorBrush x:Key="CaptionForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ResultForeground" Color="#0D47A1"/>

    <!-- Элементы (вкладки, поля) -->
    <SolidColorBrush x:Key="TileBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TileForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TileBorderBrush" Color="#BBD4F0"/>
    <SolidColorBrush x:Key="TileHoverBackground" Color="#E4F0FC"/>
    <SolidColorBrush x:Key="TilePressedBackground" Color="#C9DEF5"/>

    <!-- Кнопка "Вычислить" и активная вкладка -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#1E63A8"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#2C7AD0"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#16508A"/>

    <!-- Рамка окна -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#1E63A8"/>
    <Thickness x:Key="WindowBorderThickness">2</Thickness>

    <SolidColorBrush x:Key="FooterForeground" Color="#667288"/>
</ResourceDictionary>