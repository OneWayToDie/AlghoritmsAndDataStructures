<Window x:Class="AlghoritmsAndDataStructures.Views.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="График функции" Height="600" Width="750"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptionForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource MainBackground}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="{DynamicResource WindowBorderThickness}"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CaptionBackground}"
                    MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="График функции" 
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource CaptionForeground}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="20,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click">
                            <TextBlock Text="─" FontSize="24"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click">
                            <TextBlock Text="☐" FontSize="22"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Панель управления -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,10,20,5" HorizontalAlignment="Center">
                <Label Content="X =" Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center"/>
                <TextBox x:Name="InputX" Width="80" Margin="5,0" 
                         Text="{Binding X, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                         Style="{StaticResource {x:Type TextBox}}"/>
                <Label Content="R =" Foreground="{DynamicResource MainTextForeground}" Margin="15,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="InputR" Width="80" Margin="5,0"
                         Text="{Binding R, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                         Style="{StaticResource {x:Type TextBox}}"/>
                <Button Content="Обновить" Style="{StaticResource ActionButtonStyle}" Click="UpdateButton_Click" Margin="15,0,0,0"/>
                <Button Content="Сохранить PNG" Style="{StaticResource ActionButtonStyle}" Click="SaveButton_Click" Margin="10,0,0,0"/>
                <Button Content="Копировать" Style="{StaticResource ActionButtonStyle}" Click="CopyButton_Click" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- График (TrackerFormatString убран отсюда) -->
            <oxy:PlotView Grid.Row="2" 
                          x:Name="PlotView" 
                          Margin="20,0,20,20"
                          Background="{DynamicResource MainBackground}"/>
        </Grid>
    </Border>
</Window>