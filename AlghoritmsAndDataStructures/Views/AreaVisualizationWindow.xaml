<Window x:Class="AlghoritmsAndDataStructures.Views.AreaVisualizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Визуализация области" Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptionForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Background" Value="{DynamicResource TileBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="5,0,5,0"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="TickFrequency" Value="0.5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TileBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="80"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource MainBackground}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="{DynamicResource WindowBorderThickness}"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CaptionBackground}"
                    MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Визуализация области" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource CaptionForeground}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="20,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click">
                            <TextBlock Text="─" FontSize="24"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click">
                            <TextBlock Text="☐" FontSize="22"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основное содержимое -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Canvas для карты -->
                <Border Grid.Column="0" Background="{DynamicResource TileBackground}" 
                        BorderBrush="{DynamicResource TileBorderBrush}" BorderThickness="1" CornerRadius="5"
                        Margin="0,0,10,0">
                    <Grid>
                        <Canvas x:Name="MapCanvas" Width="500" Height="450" Background="Transparent"/>
                        <TextBlock x:Name="WarningText" Text="Визуализация доступна только для значений до 1000. Для больших значений отображается статичная картинка. Результат вычислений корректен."
                                   Foreground="Yellow" Background="#80000000" Padding="10"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                   Visibility="Collapsed" FontWeight="Bold" FontSize="14"/>
                    </Grid>
                </Border>

                <!-- Панель управления справа (исправлено: убраны привязки) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0" Width="220">
                    <!-- X -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,5">
                        <TextBlock Text="X =" Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold" VerticalAlignment="Center" Width="25"/>
                        <TextBox x:Name="InputX" Width="60"/>
                    </StackPanel>
                    <!-- Y -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,5">
                        <TextBlock Text="Y =" Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold" VerticalAlignment="Center" Width="25"/>
                        <TextBox x:Name="InputY" Width="60"/>
                    </StackPanel>
                    <!-- a -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,5">
                        <TextBlock Text="a =" Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold" VerticalAlignment="Center" Width="25"/>
                        <TextBox x:Name="InputA" Width="60"/>
                    </StackPanel>
                    <!-- b -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,5">
                        <TextBlock Text="b =" Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold" VerticalAlignment="Center" Width="25"/>
                        <TextBox x:Name="InputB" Width="60"/>
                    </StackPanel>
                    <!-- R -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="R =" Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold" VerticalAlignment="Center" Width="25"/>
                        <TextBox x:Name="InputR" Width="60"/>
                    </StackPanel>

                    <!-- Слайдеры -->
                    <TextBlock Text="Слайдеры для управления:" Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold" Margin="0,10,0,5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="a" Foreground="{DynamicResource MainTextForeground}" Width="20" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderA" Minimum="0.1" Maximum="1000" Value="4" TickFrequency="0.5"
                                ValueChanged="Slider_ValueChanged" Width="150"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="b" Foreground="{DynamicResource MainTextForeground}" Width="20" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderB" Minimum="0.1" Maximum="1000" Value="3" TickFrequency="0.5"
                                ValueChanged="Slider_ValueChanged" Width="150"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="R" Foreground="{DynamicResource MainTextForeground}" Width="20" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderR" Minimum="0.1" Maximum="1000" Value="5" TickFrequency="0.5"
                                ValueChanged="Slider_ValueChanged" Width="150"/>
                    </StackPanel>

                    <Button Content="Обновить" Style="{StaticResource CaptionButtonStyle}" Click="UpdateButton_Click" 
                            Width="120" Height="40" FontSize="16" Margin="0,15,0,0" HorizontalAlignment="Left"/>

                    <!-- Результат -->
                    <Border Background="{DynamicResource TileBackground}" BorderBrush="{DynamicResource TileBorderBrush}" 
                            BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,15,0,0">
                        <TextBlock x:Name="ResultText" Foreground="{DynamicResource ResultForeground}" FontSize="16" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Нижняя панель -->
            <Border Grid.Row="2" Background="{DynamicResource CaptionBackground}" Padding="15,8">
                <TextBlock Text="Заштрихованные области: III квадрант (внутри круга) и I квадрант (снаружи круга)" 
                           Foreground="{DynamicResource MainTextForeground}" HorizontalAlignment="Center" FontSize="14"/>
            </Border>
        </Grid>
    </Border>
</Window>