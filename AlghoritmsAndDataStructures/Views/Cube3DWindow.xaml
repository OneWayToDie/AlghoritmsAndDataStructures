<Window x:Class="AlghoritmsAndDataStructures.Views.Cube3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Куб" Height="680" Width="850"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptionForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Background" Value="{DynamicResource TileBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="TickFrequency" Value="5"/>
            <Setter Property="TickPlacement" Value="BottomRight"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="IsDirectionReversed" Value="True"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource MainBackground}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="{DynamicResource WindowBorderThickness}"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource CaptionBackground}"
                    MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="3D Куб" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource CaptionForeground}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="20,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="RotateButton" Content="🔄" Style="{StaticResource CaptionButtonStyle}" 
                                Click="RotateButton_Click" ToolTip="Автоматическое вращение"/>
                        <Button x:Name="AxisXButton" Content="X" Width="30" Height="30" 
                                Style="{StaticResource CaptionButtonStyle}" Foreground="Red" 
                                Click="AxisButton_Click" ToolTip="Вращение вокруг оси X"/>
                        <Button x:Name="AxisYButton" Content="Y" Width="30" Height="30" 
                                Style="{StaticResource CaptionButtonStyle}" Foreground="Lime" 
                                Click="AxisButton_Click" ToolTip="Вращение вокруг оси Y"/>
                        <Button x:Name="AxisZButton" Content="Z" Width="30" Height="30" 
                                Style="{StaticResource CaptionButtonStyle}" Foreground="DodgerBlue" 
                                Click="AxisButton_Click" ToolTip="Вращение вокруг оси Z"/>
                        <Button x:Name="ResetButton" Content="↺" Style="{StaticResource CaptionButtonStyle}" 
                                Click="ResetButton_Click" ToolTip="Сбросить вид"/>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click">
                            <TextBlock Text="─" FontSize="24"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click">
                            <TextBlock Text="☐" FontSize="22"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3D Сцена -->
            <Viewport3D Grid.Row="1" Grid.Column="0" x:Name="Viewport3D" Margin="10"
                        MouseMove="Viewport3D_MouseMove" MouseLeave="Viewport3D_MouseLeave">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="Camera" Position="8,8,8" LookDirection="-8,-8,-8" UpDirection="0,1,0"/>
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <DirectionalLight Color="White" Direction="-1,-1,-1"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <AmbientLight Color="#333333"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D x:Name="SceneVisual"/>
            </Viewport3D>

            <!-- Панель управления справа -->
            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                <Slider x:Name="ZoomSlider" Minimum="0" Maximum="100" Value="50"
                        ValueChanged="ZoomSlider_ValueChanged" ToolTip="Масштаб"/>
                <TextBlock x:Name="ZoomValueText" Text="50" Foreground="{DynamicResource MainTextForeground}" 
                           HorizontalAlignment="Center" FontSize="14" Margin="0,5,0,0"/>
                <TextBlock Text="🔍" Foreground="{DynamicResource MainTextForeground}" 
                           HorizontalAlignment="Center" FontSize="18" Margin="0,0,0,5"/>

                <Separator Margin="0,10,0,10" Background="{DynamicResource TileBorderBrush}"/>

                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100"
                        ValueChanged="OpacitySlider_ValueChanged" ToolTip="Прозрачность"/>
                <TextBlock x:Name="OpacityValueText" Text="100" Foreground="{DynamicResource MainTextForeground}" 
                           HorizontalAlignment="Center" FontSize="14" Margin="0,5,0,0"/>
                <TextBlock Text="👁" Foreground="{DynamicResource MainTextForeground}" 
                           HorizontalAlignment="Center" FontSize="18" Margin="0,0,0,5"/>
            </StackPanel>

            <!-- Нижняя панель -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource CaptionBackground}" Padding="15,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Ребро: " Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold"/>
                        <TextBlock x:Name="EdgeLabel" Foreground="{DynamicResource ResultForeground}" FontWeight="Bold" FontSize="16" MinWidth="60"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Площадь грани: " Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold"/>
                        <TextBlock x:Name="FaceAreaText" Foreground="{DynamicResource ResultForeground}" FontWeight="Bold" FontSize="16" MinWidth="60"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Полная поверхность: " Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold"/>
                        <TextBlock x:Name="TotalSurfaceText" Foreground="{DynamicResource ResultForeground}" FontWeight="Bold" FontSize="16" MinWidth="60"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Объём: " Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold"/>
                        <TextBlock x:Name="VolumeText" Foreground="{DynamicResource ResultForeground}" FontWeight="Bold" FontSize="16" MinWidth="60"/>
                    </StackPanel>

                    <Border Background="#3A3A5A" Padding="5" CornerRadius="5" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Цвет: " Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center" Margin="5,0,10,0"/>
                            <Button x:Name="ColorBlue" Width="24" Height="24" Background="Blue" Click="ColorButton_Click" Margin="2,0"/>
                            <Button x:Name="ColorRed" Width="24" Height="24" Background="Red" Click="ColorButton_Click" Margin="2,0"/>
                            <Button x:Name="ColorGreen" Width="24" Height="24" Background="Green" Click="ColorButton_Click" Margin="2,0"/>
                            <Button x:Name="ColorYellow" Width="24" Height="24" Background="Yellow" Click="ColorButton_Click" Margin="2,0"/>
                            <Button x:Name="ColorOrange" Width="24" Height="24" Background="Orange" Click="ColorButton_Click" Margin="2,0"/>
                            <Button x:Name="ColorPurple" Width="24" Height="24" Background="Purple" Click="ColorButton_Click" Margin="2,0"/>
                            <Button x:Name="ColorWhite" Width="24" Height="24" Background="White" Click="ColorButton_Click" Margin="2,0"/>
                            <Button x:Name="ColorCyan" Width="24" Height="24" Background="Cyan" Click="ColorButton_Click" Margin="2,0"/>
                            <Button x:Name="ColorGray" Width="24" Height="24" Background="Gray" Click="ColorButton_Click" Margin="2,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBlock Text="Оси: " Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="X" Foreground="#FF5050" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Y" Foreground="#50FF50" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Z" Foreground="#5050FF" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>