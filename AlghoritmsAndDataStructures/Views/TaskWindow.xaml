<Window x:Class="AlghoritmsAndDataStructures.Views.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tasks="clr-namespace:AlghoritmsAndDataStructures.ViewModels.Tasks"
        xmlns:conv="clr-namespace:AlghoritmsAndDataStructures.Converters"
        xmlns:controls="clr-namespace:AlghoritmsAndDataStructures.Views.Controls"
        Title="Практическая работа" 
        Height="810" Width="850"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" 
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <Style x:Key="CenteredTextBlock" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- Стиль для кнопок заголовка -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptionForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопок действий -->
        <Style x:Key="ComputeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,10,5,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для вкладок -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MainTextForeground}"/>
            <Setter Property="Background" Value="{DynamicResource TileBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ButtonBackground}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,4"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{DynamicResource ButtonForeground}"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Общие стили -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource MainTextForeground}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TileBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MainTextForeground}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource TileBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="MaxHeight" Value="150"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- ============================================================ -->
        <!-- DataTemplate для задачи 1 (Куб) — без изменений             -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type tasks:CubeTaskViewModel}">
            <!-- ... (остаётся как было) ... -->
            <StackPanel Margin="10">
                <TextBlock Text="Введите длину ребра:" FontWeight="Bold" 
                           Foreground="{DynamicResource MainTextForeground}"/>
                <TextBox Text="{Binding Edge, UpdateSourceTrigger=PropertyChanged}" 
                         Width="150" HorizontalAlignment="Left"/>

                <Button Content="Вычислить" 
                        Command="{Binding ComputeCommand}"
                        Style="{StaticResource ComputeButtonStyle}"/>
                <Button Content="Показать 3D куб" 
                        Command="{Binding Show3DCubeCommand}"
                        Style="{StaticResource ComputeButtonStyle}"
                        Margin="5,10,5,10"/>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>

                <TextBlock Text="Результаты:" FontWeight="Bold" 
                           Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Площадь грани:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="{Binding FaceArea, StringFormat={}{0:F2}}" 
                               Foreground="{DynamicResource ResultForeground}"
                               VerticalAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Полная поверхность:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="{Binding TotalSurface, StringFormat={}{0:F2}}"
                               Foreground="{DynamicResource ResultForeground}"
                               VerticalAlignment="Center"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Объём:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" 
                               Text="{Binding Volume, StringFormat={}{0:F2}}"
                               Foreground="{DynamicResource ResultForeground}"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Binding ResultText}" 
                           Foreground="{DynamicResource MainTextForeground}" 
                           Margin="0,10,0,0"/>

                <TextBlock Text="{Binding CalculationSteps}" 
                           Foreground="{DynamicResource MainTextForeground}"
                           FontFamily="Consolas"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding CalculationSteps, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>
                <Button Content="История вычислений" 
                        Command="{Binding ShowHistoryCommand}"
                        Style="{StaticResource ComputeButtonStyle}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================ -->
        <!-- DataTemplate для задачи 2 (Дробь) — без изменений           -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type tasks:FractionTaskViewModel}">
            <!-- ... (остаётся как было) ... -->
            <StackPanel Margin="10">
                <TextBlock Text="Введите M и N (натуральные):" FontWeight="Bold"
                           Foreground="{DynamicResource MainTextForeground}"/>
                <StackPanel Orientation="Horizontal">
                    <Label Content="M ="/>
                    <TextBox Text="{Binding M, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <Label Content="N =" Margin="15,0,0,0"/>
                    <TextBox Text="{Binding N, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                </StackPanel>

                <Button Content="Вычислить" 
                        Command="{Binding ComputeCommand}"
                        Style="{StaticResource ComputeButtonStyle}"/>
                <Button Content="Показать визуализацию" 
                        Command="{Binding ShowVisualizationCommand}"
                        Style="{StaticResource ComputeButtonStyle}"
                        Margin="5,10,5,10"/>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>

                <TextBlock Text="Результаты:" FontWeight="Bold" 
                           Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Младшая цифра целой части:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="{Binding IntegerLastDigit}"
                               Foreground="{DynamicResource ResultForeground}"
                               VerticalAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Старшая цифра дробной части:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="{Binding FractionFirstDigit}"
                               Foreground="{DynamicResource ResultForeground}"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="{Binding ResultText}" 
                           Foreground="{DynamicResource MainTextForeground}" 
                           Margin="0,10,0,0"/>

                <TextBlock Text="{Binding CalculationSteps}" 
                           Foreground="{DynamicResource MainTextForeground}"
                           FontFamily="Consolas"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding CalculationSteps, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>
                <Button Content="История вычислений" 
                        Command="{Binding ShowHistoryCommand}"
                        Style="{StaticResource ComputeButtonStyle}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================ -->
        <!-- DataTemplate для задачи "Вычисление функции по графику"     -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type tasks:GraphTaskViewModel}">
            <StackPanel Margin="10">
                <TextBlock Text="Введите аргумент X и параметр R:" FontWeight="Bold" 
                           Foreground="{DynamicResource MainTextForeground}"/>
                <StackPanel Orientation="Horizontal">
                    <Label Content="X ="/>
                    <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <Label Content="R =" Margin="15,0,0,0"/>
                    <TextBox Text="{Binding R, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Вычислить" 
                            Command="{Binding ComputeCommand}"
                            Style="{StaticResource ComputeButtonStyle}"/>
                    <Button Content="Показать график" 
                            Command="{Binding ShowGraphCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="5,10,5,10"/>
                </StackPanel>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>

                <TextBlock Text="Результат:" FontWeight="Bold" 
                           Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding ResultText}" 
                           Foreground="{DynamicResource ResultForeground}" 
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,10,0,0"/>

                <Button Content="История вычислений" 
                        Command="{Binding ShowHistoryCommand}"
                        Style="{StaticResource ComputeButtonStyle}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================ -->
        <!-- DataTemplate для задачи "Попадание точки в область"         -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type tasks:AreaTaskViewModel}">
            <StackPanel Margin="10">
                <TextBlock Text="Введите координаты точки и параметры фигур:" FontWeight="Bold" 
                           Foreground="{DynamicResource MainTextForeground}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="X =" Foreground="{DynamicResource MainTextForeground}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="Y =" Foreground="{DynamicResource MainTextForeground}" Margin="15,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="80"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="a =" Foreground="{DynamicResource MainTextForeground}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding A, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="b =" Foreground="{DynamicResource MainTextForeground}" Margin="15,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding B, UpdateSourceTrigger=PropertyChanged}" Width="80"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="R =" Foreground="{DynamicResource MainTextForeground}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding R, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Проверить" 
                            Command="{Binding ComputeCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="0,10,5,10"/>
                    <Button Content="Показать карту" 
                            Command="{Binding ShowVisualizationCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="5,10,0,10"/>
                    <Button Content="Очистить историю" 
                            Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="5,10,0,10"/>
                </StackPanel>

                <TextBlock Text="{Binding ResultText}" 
                           Foreground="{DynamicResource ResultForeground}" 
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,10,0,0"/>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>
                <Button Content="История проверок" 
                        Command="{Binding ShowHistoryCommand}"
                        Style="{StaticResource ComputeButtonStyle}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================ -->
        <!-- DataTemplate для задачи 1: Сумма ряда (с гистограммой)      -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type tasks:SeriesSumTaskViewModel}">
            <StackPanel Margin="10">
                <TextBlock Text="Введите n (n > 1):" FontWeight="Bold" 
                           Foreground="{DynamicResource MainTextForeground}"/>
                <TextBox Text="{Binding N, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Вычислить" 
                            Command="{Binding ComputeCommand}"
                            Style="{StaticResource ComputeButtonStyle}"/>
                    <Button Content="Ход решения" 
                            Command="{Binding ShowSolutionCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="5,10,5,10"/>
                    <Button Content="История вычислений" 
                            Command="{Binding ShowHistoryCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="5,10,5,10"/>
                </StackPanel>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>

                <TextBlock Text="Результат:" FontWeight="Bold" 
                           Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding ResultText}" 
                           Foreground="{DynamicResource ResultForeground}" 
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,10,0,0"/>

                <TextBlock Text="{Binding Sum, StringFormat='Значение суммы: {0:F6}'}" 
                           Foreground="{DynamicResource MainTextForeground}" 
                           Margin="0,10,0,0"/>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>
                <TextBlock Text="Визуализация членов ряда:" FontWeight="Bold" 
                           Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,10"/>
                <controls:HistogramControl Data="{Binding MembersList}" 
                                           Mode="Series"
                                           Height="200" Width="450"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================ -->
        <!-- DataTemplate для задачи 2: Среднее трёхзначных (с гистогр.) -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type tasks:AverageTaskViewModel}">
            <StackPanel Margin="10">
                <TextBlock Text="Введите числа через запятую (или пробел):" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}"/>
                <TextBox Text="{Binding InputNumbers, UpdateSourceTrigger=PropertyChanged}" 
                 Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Top"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Найти среднее" 
                    Command="{Binding ComputeCommand}"
                    Style="{StaticResource ComputeButtonStyle}"/>
                    <Button Content="Ход решения" 
                    Command="{Binding ShowSolutionCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                    <Button Content="История вычислений" 
                    Command="{Binding ShowHistoryCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                </StackPanel>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>

                <TextBlock Text="Результат:" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding ResultText}" 
                   Foreground="{DynamicResource ResultForeground}" 
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,10,0,0"/>

                <TextBlock Text="{Binding ResultDetail}" 
                   Foreground="{DynamicResource MainTextForeground}" 
                   TextWrapping="Wrap"
                   Margin="0,5,0,0"/>

                <!-- Список трёхзначных чисел (в строку) -->
                <TextBlock Text="Найденные трёхзначные числа: " FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}" Margin="0,10,0,5"
                   Visibility="{Binding ThreeDigitNumbers.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ThreeDigitString}" 
                   Foreground="{DynamicResource MainTextForeground}" 
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Visibility="{Binding ThreeDigitNumbers.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                <!-- Гистограмма для трёхзначных чисел -->
                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>
                <TextBlock Text="Визуализация трёхзначных чисел:" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,10"/>
                <controls:HistogramControl Data="{Binding ThreeDigitNumbers}" 
                                   Mode="Average"
                                   AverageValue="{Binding AverageValue}"
                                   Height="200" Width="450"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================ -->
        <!-- DataTemplate для задачи "Обработка массива" (5-я работа)     -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type tasks:ArrayTaskViewModel}">
            <StackPanel Margin="10">
                <TextBlock Text="Введите 12 целых чисел через запятую (или пробел):" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}"/>
                <TextBox Text="{Binding InputArray, UpdateSourceTrigger=PropertyChanged}" 
                 Height="40" TextWrapping="Wrap" AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Сгенерировать массив" 
                    Command="{Binding GenerateArrayCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="0,10,5,10"/>
                    <Button Content="Обработать" 
                    Command="{Binding ComputeCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                    <Button Content="Ход решения" 
                    Command="{Binding ShowSolutionCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                    <Button Content="История" 
                    Command="{Binding ShowHistoryCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                </StackPanel>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>

                <TextBlock Text="Результат:" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ResultMessage}" 
                   Foreground="{DynamicResource ResultForeground}" 
                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Исходный массив: " FontWeight="Bold" Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OriginalArrayDisplay}" 
                       Foreground="{DynamicResource MainTextForeground}" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Изменённый массив: " FontWeight="Bold" Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ModifiedArrayDisplay}" 
                       Foreground="{DynamicResource MainTextForeground}" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Гистограмма -->
                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>
                <TextBlock Text="Визуализация:" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Исходный массив" Command="{Binding SwitchDisplayModeCommand}" CommandParameter="Original"
                    Style="{StaticResource ComputeButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Изменённый массив" Command="{Binding SwitchDisplayModeCommand}" CommandParameter="Modified"
                    Style="{StaticResource ComputeButtonStyle}" Margin="0,0,0,0"/>
                </StackPanel>

                <controls:HistogramControl Data="{Binding CurrentItems}" 
                                   HighlightIndices="{Binding HighlightIndices}"
                                   SpecialIndices="{Binding SpecialIndices}"
                                   Height="250" Width="500"/>

                <!-- Легенда -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Rectangle Width="20" Height="10" Fill="DodgerBlue" Margin="5"/>
                    <TextBlock Text="Обычные" Foreground="{DynamicResource MainTextForeground}" Margin="5,0,15,0"/>
                    <Rectangle Width="20" Height="10" Fill="Gold" Margin="5"/>
                    <TextBlock Text="Нечётные позиции" Foreground="{DynamicResource MainTextForeground}" Margin="5,0,15,0"/>
                    <Rectangle Width="20" Height="10" Fill="Transparent" Stroke="Red" StrokeThickness="2" Margin="5"/>
                    <TextBlock Text="Кратные 3" Foreground="{DynamicResource MainTextForeground}" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================ -->
        <!-- DataTemplate для задачи "Разложение e^(-x) в ряд" (6-я работа) -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type tasks:SeriesTaskViewModel}">
            <StackPanel Margin="10">
                <TextBlock Text="Введите параметры (или нажмите 'Сгенерировать'):" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="A =" Foreground="{DynamicResource MainTextForeground}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AStr, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="B =" Foreground="{DynamicResource MainTextForeground}" Margin="15,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding BStr, UpdateSourceTrigger=PropertyChanged}" Width="80"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="dx =" Foreground="{DynamicResource MainTextForeground}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DxStr, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    <Label Grid.Row="1" Grid.Column="2" Content="eps =" Foreground="{DynamicResource MainTextForeground}" Margin="15,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EpsStr, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Сгенерировать" 
                            Command="{Binding GenerateCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="0,10,10,10"/>
                    <Button Content="Вычислить" 
                            Command="{Binding ComputeCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="0,10,10,10"/>
                    <Button Content="Ход решения" 
                            Command="{Binding ShowSolutionCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="0,10,10,10"/>
                    <Button Content="История" 
                            Command="{Binding ShowHistoryCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="0,10,10,10"/>
                    <Button Content="Сходимость" 
                            Command="{Binding ShowConvergenceCommand}"
                            Style="{StaticResource ComputeButtonStyle}"
                            Margin="0,10,10,10"/>
                </StackPanel>

                
                <TextBlock Text="{Binding ResultMessage}" 
                   Foreground="{DynamicResource ResultForeground}" 
                   FontSize="14" FontWeight="Bold" Margin="0,10,0,0"/>

                <!-- Таблица (оставляем как есть) -->
                <DataGrid ItemsSource="{Binding Results}" 
                          AutoGenerateColumns="False"
                          Background="{DynamicResource TileBackground}"
                          BorderBrush="{DynamicResource TileBorderBrush}"
                          BorderThickness="1"
                          Margin="0,10,0,0"
                          MaxHeight="300"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          GridLinesVisibility="Vertical"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HorizontalAlignment="Stretch"
                          ColumnHeaderHeight="30">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{DynamicResource MainTextForeground}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="5,2"/>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Foreground" Value="{DynamicResource MainTextForeground}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Background" Value="{DynamicResource CaptionBackground}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="Padding" Value="5,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource TileBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MainTextForeground}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="X" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding X, StringFormat=F3}" 
                                       TextAlignment="Center" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Foreground="{DynamicResource MainTextForeground}"/>
                                </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="X" 
                                       TextAlignment="Center" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MainTextForeground}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Сумма ряда" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Sum, StringFormat=F6}" 
                                       TextAlignment="Center" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Foreground="{DynamicResource MainTextForeground}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Сумма ряда" 
                                       TextAlignment="Center" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MainTextForeground}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Членов" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Terms}" 
                                       TextAlignment="Center" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Foreground="{DynamicResource MainTextForeground}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Членов" 
                                       TextAlignment="Center" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MainTextForeground}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Точное значение" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Exact, StringFormat=F6}" 
                                       TextAlignment="Center" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Foreground="{DynamicResource MainTextForeground}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Точное значение" 
                                       TextAlignment="Center" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MainTextForeground}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Погрешность" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Error, StringFormat=E6}" 
                                       TextAlignment="Center" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       Foreground="{DynamicResource MainTextForeground}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Погрешность" 
                                       TextAlignment="Center" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MainTextForeground}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================ -->
        <!-- DataTemplate для задачи "Быстрая сортировка" (7-я работа)    -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type tasks:QuickSortTaskViewModel}">
            <StackPanel Margin="10">
                <TextBlock Text="Нажмите «Сгенерировать» для создания массива из 25 случайных чисел:" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Сгенерировать массив" 
                    Command="{Binding GenerateArrayCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="0,10,5,10"/>
                    <Button Content="Выполнить сортировку" 
                    Command="{Binding ComputeCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                    <Button Content="Ход решения" 
                    Command="{Binding ShowSolutionCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                    <Button Content="Визуализация" 
                    Command="{Binding ShowVisualizationCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                    <Button Content="История" 
                    Command="{Binding ShowHistoryCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                </StackPanel>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>

                <TextBlock Text="Результат:" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ResultMessage}" 
                   Foreground="{DynamicResource ResultForeground}" 
                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Сравнений: " FontWeight="Bold" Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ComparisonsCount}" Foreground="{DynamicResource ResultForeground}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="    Перестановок: " FontWeight="Bold" Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SwapsCount}" Foreground="{DynamicResource ResultForeground}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Исходный массив: " FontWeight="Bold" Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OriginalArrayDisplay}" 
                       Foreground="{DynamicResource MainTextForeground}" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Отсортированный: " FontWeight="Bold" Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SortedArrayDisplay}" 
                       Foreground="{DynamicResource MainTextForeground}" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Гистограмма -->
                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>
                <TextBlock Text="Визуализация:" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Исходный массив" Command="{Binding SwitchDisplayModeCommand}" CommandParameter="Original"
                    Style="{StaticResource ComputeButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Отсортированный" Command="{Binding SwitchDisplayModeCommand}" CommandParameter="Sorted"
                    Style="{StaticResource ComputeButtonStyle}" Margin="0,0,0,0"/>
                </StackPanel>

                <controls:HistogramControl Data="{Binding CurrentItems}" 
                                   Height="250" Width="500"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================ -->
        <!-- DataTemplate для задачи "Среднее арифм. соседей" (8-я работа) -->
        <!-- ============================================================ -->
        <DataTemplate DataType="{x:Type tasks:NeighborhoodAverageTaskViewModel}">
            <StackPanel Margin="10">
                <TextBlock Text="Введите целые числа через запятую (или пробел):" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}"/>
                <TextBox Text="{Binding InputArray, UpdateSourceTrigger=PropertyChanged}" 
                 Height="40" TextWrapping="Wrap" AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Сгенерировать массив" 
                    Command="{Binding GenerateArrayCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="0,10,5,10"/>
                    <Button Content="Обработать" 
                    Command="{Binding ComputeCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                    <Button Content="Ход решения" 
                    Command="{Binding ShowSolutionCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                    <Button Content="История" 
                    Command="{Binding ShowHistoryCommand}"
                    Style="{StaticResource ComputeButtonStyle}"
                    Margin="5,10,5,10"/>
                </StackPanel>

                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>

                <TextBlock Text="Результат:" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ResultMessage}" 
                   Foreground="{DynamicResource ResultForeground}" 
                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Исходный массив: " FontWeight="Bold" Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OriginalArrayDisplay}" 
                       Foreground="{DynamicResource MainTextForeground}" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Результат: " FontWeight="Bold" Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ModifiedArrayDisplay}" 
                       Foreground="{DynamicResource MainTextForeground}" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Гистограмма -->
                <Separator Margin="0,15,0,15" Background="{DynamicResource TileBorderBrush}"/>
                <TextBlock Text="Визуализация:" FontWeight="Bold" 
                   Foreground="{DynamicResource MainTextForeground}" Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Исходный массив" Command="{Binding SwitchDisplayModeCommand}" CommandParameter="Original"
                    Style="{StaticResource ComputeButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="Изменённый массив" Command="{Binding SwitchDisplayModeCommand}" CommandParameter="Modified"
                    Style="{StaticResource ComputeButtonStyle}" Margin="0,0,0,0"/>
                </StackPanel>

                <controls:HistogramControl Data="{Binding CurrentItems}" 
                                   Height="250" Width="500"/>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Border Background="{DynamicResource MainBackground}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="{DynamicResource WindowBorderThickness}"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="{DynamicResource CaptionBackground}" 
                    MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Практическая работа" 
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource CaptionForeground}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="20,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click">
                            <TextBlock Text="─" FontSize="24"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" IsEnabled="False" Opacity="0.3">
                            <TextBlock Text="☐" FontSize="22"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <TabControl ItemsSource="{Binding Tasks}" SelectedIndex="0"
                            Background="{DynamicResource MainBackground}"
                            BorderThickness="0">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" 
                                       Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=TabItem}, Path=Foreground}"
                                       FontWeight="SemiBold"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}"/>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>