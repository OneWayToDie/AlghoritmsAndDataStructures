<Window x:Class="AlghoritmsAndDataStructures.Views.QuickSortVisualizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Визуализация быстрой сортировки" Height="560" Width="860"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptionForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource MainBackground}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="{DynamicResource WindowBorderThickness}"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CaptionBackground}"
                    MouseLeftButtonDown="CaptionBorder_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Визуализация быстрой сортировки" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource CaptionForeground}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Margin="20,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click">
                            <TextBlock Text="─" FontSize="24"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click">
                            <TextBlock Text="☐" FontSize="22"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Область сортировки -->
            <Grid Grid.Row="1" Margin="20,15,20,5">
                <Border Background="{DynamicResource TileBackground}"
                        BorderBrush="{DynamicResource TileBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Canvas x:Name="SortCanvas" ClipToBounds="True" Margin="10"/>
                </Border>
            </Grid>

            <!-- Информационная панель -->
            <Border Grid.Row="2" Background="{DynamicResource CaptionBackground}" Padding="15,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Описание шага -->
                    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="DescriptionText"
                               Foreground="{DynamicResource MainTextForeground}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,10,4"/>

                    <!-- Счётчики -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Сравнения: " Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold"/>
                        <TextBlock x:Name="ComparisonsText" Foreground="{DynamicResource ResultForeground}" FontWeight="Bold" FontSize="16" Margin="0,0,15,0"/>
                        <TextBlock Text="Перестановки: " Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold"/>
                        <TextBlock x:Name="SwapsText" Foreground="{DynamicResource ResultForeground}" FontWeight="Bold" FontSize="16" Margin="0,0,15,0"/>
                        <TextBlock Text="Шаг: " Foreground="{DynamicResource MainTextForeground}" FontWeight="Bold"/>
                        <TextBlock x:Name="StepText" Foreground="{DynamicResource ResultForeground}" FontWeight="Bold" FontSize="16"/>
                    </StackPanel>

                    <!-- Управление -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource ActionButtonStyle}" Content="⏮ В начало" Click="FirstButton_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="◀ Шаг назад" Click="StepBackButton_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Шаг вперёд ▶" Click="StepForwardButton_Click"/>
                        <Button x:Name="PlayButton" Style="{StaticResource ActionButtonStyle}" Content="▶ Авто" Click="PlayButton_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="⏸" Click="PauseButton_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="↺ Заново" Click="ResetButton_Click"/>
                    </StackPanel>

                    <!-- Скорость -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Скорость:" Foreground="{DynamicResource MainTextForeground}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Slider x:Name="SpeedSlider" Width="120" Minimum="1" Maximum="50" Value="20"
                                TickFrequency="1" IsSnapToTickEnabled="False"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>